<?xml version="1.0" encoding="utf-8"?>
<!--
  HTTPS is enforced everywhere by default. Cleartext is allowed ONLY for local
  development backends (the Android emulator reaches the host machine's
  localhost via 10.0.2.2). Production traffic stays TLS-only.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
